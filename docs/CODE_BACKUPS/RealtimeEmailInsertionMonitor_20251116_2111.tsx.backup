import React from 'react';
import { useQuery } from '@tanstack/react-query';
import { supabase } from '@/integrations/supabase/client';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { ScrollArea } from '@/components/ui/scroll-area';
import { Database, FolderOpen } from 'lucide-react';

interface RealtimeEmailInsertionMonitorProps {
  userEmail: string;
  isActive: boolean;
}

interface EmailRow {
  message_id: string;
  subject: string | null;
  from_email: string | null;
  cartella: string | null;
  created_at: string;
}

function formatRelativeTime(isoDate: string): string {
  const now = Date.now();
  const date = new Date(isoDate).getTime();
  const diffSeconds = Math.floor((now - date) / 1000);
  
  if (diffSeconds < 5) return 'Ora';
  if (diffSeconds < 60) return `${diffSeconds}s fa`;
  if (diffSeconds < 3600) return `${Math.floor(diffSeconds / 60)}m fa`;
  return `${Math.floor(diffSeconds / 3600)}h fa`;
}

export function RealtimeEmailInsertionMonitor({ userEmail, isActive }: RealtimeEmailInsertionMonitorProps) {
  const { data: recentEmails = [] } = useQuery({
    queryKey: ['realtime-email-insertions', userEmail],
    queryFn: async () => {
      const tenMinutesAgo = new Date(Date.now() - 10 * 60 * 1000).toISOString();
      
      const { data, error } = await supabase
        .from('email_messages')
        .select('message_id, subject, from_email, cartella, created_at')
        .eq('user_email', userEmail)
        .eq('sync_status', 'fun_email_backup')
        .gte('created_at', tenMinutesAgo)
        .order('created_at', { ascending: false })
        .limit(30);
      
      if (error) {
        console.error('[RealtimeMonitor] Query error:', error);
        throw error;
      }
      
      return (data || []) as EmailRow[];
    },
    refetchInterval: isActive ? 2000 : false,
    enabled: isActive && !!userEmail,
    staleTime: 0
  });

  return (
    <Card className="border-green-500 border-2 bg-green-50/5 dark:bg-green-950/10">
      <CardHeader className="pb-2">
        <div className="flex items-center justify-between">
          <CardTitle className="text-sm flex items-center gap-2">
            <Database className="h-4 w-4 text-green-500 animate-pulse" />
            Email Inserite nel Database
          </CardTitle>
          <Badge variant="outline" className="bg-green-500/20 text-green-600 dark:text-green-400">
            📥 {recentEmails.length} righe
          </Badge>
        </div>
      </CardHeader>
      
      <CardContent className="pt-2">
        <ScrollArea className="h-[200px] pr-4">
          <div className="space-y-2">
            {recentEmails.map((email, idx) => (
              <div 
                key={email.message_id}
                className="flex items-start gap-2 p-2 rounded bg-background/50 border border-green-500/20 text-xs animate-fade-in"
                style={{ animationDelay: `${idx * 50}ms` }}
              >
                <FolderOpen className="h-3 w-3 text-green-500 mt-0.5 flex-shrink-0" />
                
                <div className="flex-1 min-w-0 space-y-1">
                  <p className="font-semibold truncate text-foreground">
                    {email.subject || '(Nessun oggetto)'}
                  </p>
                  <div className="flex items-center gap-2 text-muted-foreground">
                    <span className="truncate">Da: {email.from_email || 'Sconosciuto'}</span>
                    <span className="text-[10px]">•</span>
                    <span className="flex-shrink-0">{email.cartella || 'N/A'}</span>
                  </div>
                </div>
                
                <span className="text-[10px] text-muted-foreground flex-shrink-0 mt-0.5">
                  {formatRelativeTime(email.created_at)}
                </span>
              </div>
            ))}
          </div>
        </ScrollArea>
        
        {recentEmails.length === 0 && (
          <div className="text-center py-8 text-muted-foreground text-sm">
            🔍 In attesa di nuove email...
          </div>
        )}
      </CardContent>
    </Card>
  );
}
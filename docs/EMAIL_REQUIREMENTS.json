{
  "metadata": {
    "version": "1.0.0",
    "created_at": "2025-01-29",
    "project": "TMWEngine",
    "purpose": "Requisitos funcionales de email para comparación con TMWE API",
    "architecture_target": "API-Only (sin database locale)"

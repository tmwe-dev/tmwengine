  "requirements": [
    {
      "id": "RF-EM-001",
      "name": "Visualización de lista de emails",
      "description": "Mostrar lista de emails con subject, sender, fecha, preview del body",
      "category": "reading",
      "priority": "critical",
      "current_implementation": {
        "source": "email_messages table (Supabase)",
        "components": ["EmailList", "EmailListItem"],
        "hooks": ["useEmails", "useEmailList"]
      },
      "api_only_impact": {
        "change_required": true,
        "new_source": "TMWE API /email_message endpoint",
        "benefits": ["Datos siempre frescos", "Sin sincronización"],
        "challenges": ["Latencia de red", "Paginación server-side"]
      },
      "data_dependencies": ["message_id", "subject", "sender_email", "sender_name", "received_at", "body_preview"],
      "acceptance_criteria": [
        "Lista carga en < 2 segundos",
        "Paginación funcional",
        "Preview truncado a 100 caracteres"
      ]
    },
    {
      "id": "RF-EM-002",
      "name": "Visualización de email completo",
      "description": "Mostrar email completo con body HTML/TEXT, attachments, headers",
      "category": "reading",
      "priority": "critical",
      "current_implementation": {
        "source": "email_messages.body_html, body_text",
        "components": ["EmailViewer", "EmailBody", "AttachmentList"],
        "hooks": ["useEmailDetail"]
      },
      "api_only_impact": {
        "change_required": true,
        "new_source": "TMWE API /email_message con full body",
        "benefits": ["Sin almacenamiento local de bodies grandes"],
        "challenges": ["Carga bajo demanda"]
      },
      "data_dependencies": ["body_html", "body_text", "attachments", "headers"],
      "acceptance_criteria": [
        "HTML renderizado correctamente",
        "Fallback a TEXT si no hay HTML",
        "Attachments listados con tamaño"
      ]
    },
